# Client-facing environment variables (.env)
# Copy this to .env.local for local frontend development
# NEVER commit .env or .env.local with real production secrets!

# Public Turnstile site key (safe for client-side inclusion)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# Cloudflare Web Analytics token (optional if automatic proxy injection is enabled)
NEXT_PUBLIC_CF_BEACON_TOKEN=""

# Public app URL
NEXT_PUBLIC_APP_URL="https://skypalette.app"
