# Local Worker secrets for `npm run dev`.
# Copy to `.dev.vars` (git-ignored) and fill in. NEVER commit `.dev.vars`.
#
# `TURNSTILE_SITE_KEY` is public and lives in `wrangler.jsonc` `vars`.
# These values belong in Cloudflare, not in GitHub:

TURNSTILE_SECRET_KEY="0x4AAAAAA..."
IP_SALT="generate-with: openssl rand -hex 32"
ADMIN_TOKEN="generate-with: openssl rand -hex 32"
# Set to "false" to pause uploads without a deploy.
UPLOADS_ENABLED="true"
ENVIRONMENT="development"
