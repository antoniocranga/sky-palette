# ---------------------------------------------------------------------------
# Sky Palette — repository hygiene
# This project is public. Nothing here may contain secrets or machine paths.
# ---------------------------------------------------------------------------

# Local secrets and environment (never commit real values)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/
*.tfvars
*.tfstate*

# Cloudflare / Wrangler local state
.wrangler/
.cloudflare/
.mf/
.dev.vars.local

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.cache/
.turbo/

# Review artifacts (local screenshots, not part of the source tree)
docs/assets/review/

# Tests and reports
coverage/
reports/
playwright-report/
test-results/
blob-report/
*.lcov

# Agent tooling (local only)
.agents/
.gemini/
.claude/
.cursor/
scratch/

# Editors and OS
.DS_Store
._*
*.swp
*.swo
*~
*.bak
*.tmp
*.log
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# TypeScript incremental state
*.tsbuildinfo
