{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sky-palette",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "skypalette.app",
      "zone_name": "skypalette.app",
      "custom_domain": true
    },
    {
      "pattern": "www.skypalette.app",
      "zone_name": "skypalette.app",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sky-palette-db",
      "database_id": "5e1c6b54-4020-4e9b-a5d5-0cea27498741"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "sky-photos"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_URL": "https://skypalette.app",
    "OTEL_SERVICE_NAME": "sky-palette"
  }
}
