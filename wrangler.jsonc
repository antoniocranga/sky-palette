{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sky-palette",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "sky-palette-staging",
      "routes": [
        {
          "pattern": "staging.skypalette.app",
          "zone_name": "skypalette.app",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sky-palette-db-staging",
          "database_id": "20ab2ccb-37c3-4742-bab0-faf791c26b28"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "sky-photos-staging"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_URL": "https://staging.skypalette.app"
      }
    },
    "production": {
      "name": "sky-palette",
      "routes": [
        {
          "pattern": "skypalette.app",
          "zone_name": "skypalette.app",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sky-palette-db",
          "database_id": "5e1c6b54-4020-4e9b-a5d5-0cea27498741"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "sky-photos"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_URL": "https://skypalette.app"
      }
    }
  }
}
